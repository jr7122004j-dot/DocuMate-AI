# ==============================================================================
# DocuMate-AI Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values as needed.
# All environment variables use the DOCUMATE_ prefix.

# ------------------------------------------------------------------------------
# Ollama and Model Settings
# ------------------------------------------------------------------------------
DOCUMATE_OLLAMA_BASE_URL=http://localhost:11434
DOCUMATE_LLM_MODEL_NAME=phi4-mini
DOCUMATE_EMBEDDING_MODEL_NAME=all-minilm:l6-v2
DOCUMATE_LLM_TEMPERATURE=0.15
DOCUMATE_LLM_TOP_K=10
DOCUMATE_LLM_TOP_P=0.9
DOCUMATE_LLM_REPEAT_PENALTY=1.1
DOCUMATE_LLM_NUM_CTX=4096

# ------------------------------------------------------------------------------
# Document Processing & Chunking
# ------------------------------------------------------------------------------
DOCUMATE_CHUNK_SIZE=500
DOCUMATE_CHUNK_OVERLAP=100
DOCUMATE_RETRIEVER_RESULT_COUNT=3
DOCUMATE_MAX_PDF_PAGES=500
DOCUMATE_MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# Storage & Persistence Paths
# ------------------------------------------------------------------------------
DOCUMATE_DATA_DIR=./data
DOCUMATE_CACHE_DIR=./data/cache
DOCUMATE_CHROMA_DIR=./data/chroma_db

# ------------------------------------------------------------------------------
# Semantic Cache & UI Matching
# ------------------------------------------------------------------------------
DOCUMATE_SIMILARITY_THRESHOLD=0.85
DOCUMATE_SIMILARITY_SLIDER_MIN=0.50
DOCUMATE_SIMILARITY_SLIDER_MAX=0.99
DOCUMATE_SIMILARITY_SLIDER_STEP=0.01

# ------------------------------------------------------------------------------
# Chat History, Streaming & Logging
# ------------------------------------------------------------------------------
DOCUMATE_CHAT_HISTORY_WINDOW=5
DOCUMATE_STREAM_RENDER_INTERVAL_SECONDS=0.03
DOCUMATE_MULTI_QUESTION_STREAM_CHUNK_SIZE=200
DOCUMATE_SOURCE_CONTENT_PREVIEW_LENGTH=300
DOCUMATE_LOG_LEVEL=INFO
